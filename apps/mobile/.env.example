# The one API address the app uses; the SignalR hub is derived from it.
# Local development: your computer's LAN address (a phone cannot reach
# "localhost"). EAS preview/production builds do NOT read this file — they take
# EXPO_PUBLIC_API_URL from the EAS environment (docs/TEST_DEPLOYMENT.md).
#   Local:  http://192.168.x.x:5062
#   Test:   https://<your-render-service>.onrender.com
EXPO_PUBLIC_API_URL=http://192.168.x.x:5062

# Auth0 — public client values, safe to ship in the app (never put secrets here).
# See docs/LOCAL_DEVELOPMENT.md ("Authentication") for tenant setup.
# After changing EXPO_PUBLIC_AUTH0_DOMAIN you must rebuild the development
# build (npx expo run:android) because the native callback config changes.
EXPO_PUBLIC_AUTH0_DOMAIN=dev-xxxxxxxx.au.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=your-native-application-client-id
EXPO_PUBLIC_AUTH0_AUDIENCE=https://sahno-api.local
