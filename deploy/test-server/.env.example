# Copy to .env on the server and fill in. .env is gitignored — never commit it.
#
# A literal "$" in any value must be written as "$$" (Compose substitutes
# variables in this file).

# Public name of the API (a DNS A record to this server, "DNS only" if the
# zone is on Cloudflare). Without a domain, sslip.io resolves any
# name containing an IP back to that IP, so 203.0.113.10 becomes
#   sahno.203-0-113-10.sslip.io
SAHNO_HOST=api-test.sahno.app

# Local port the API listens on (127.0.0.1 only) for the reverse proxy.
# Change it if another app on this server already uses 8080.
SAHNO_API_PORT=8080

# Supabase (Sydney) session pooler, in Npgsql keyword form, e.g.
# Host=aws-0-ap-southeast-2.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<ref>;Password='<password>';SSL Mode=Require;Maximum Pool Size=10;Keepalive=30
SAHNO_DB_CONNECTION=

# Same values as the API's local user secrets and the app's EXPO_PUBLIC_AUTH0_*.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Optional. Unset: email is logged instead of sent.
RESEND_API_KEY=
# Optional. Only with Expo "enhanced push security".
EXPO_ACCESS_TOKEN=

# Only when the server's reverse proxy is itself a Docker container: join its
# network (compose.shared-proxy.yaml). Uncomment both and set the network name.
#COMPOSE_FILE=compose.yaml:compose.shared-proxy.yaml
#PROXY_NETWORK=

# How HTTPS reaches the API: "tunnel" (Cloudflare Tunnel), "caddy" (bundled
# Caddy on 80/443), or empty (a proxy the server already runs).
COMPOSE_PROFILES=tunnel

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel).
# A secret: anyone holding it can serve traffic for SAHNO_HOST.
CLOUDFLARE_TUNNEL_TOKEN=
